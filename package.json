{
  "name": "jira-sprints-nestjs",
  "version": "1.0.0",
  "description": "MS2: Sprints & Planning Microservice in NestJS with gRPC and Kafka",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage && node scripts/check-coverage.js",
    "coverage:check": "bash scripts/check-coverage.sh coverage/coverage-summary.json 60.0",
    "coverage:check:ps1": "powershell -ExecutionPolicy Bypass -File scripts/check-coverage.ps1 -CoverageFile coverage/coverage-summary.json -Threshold 60.0",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'coverage'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }));\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/microservices": "^10.4.5",
    "@nestjs/typeorm": "^10.0.2",
    "dotenv": "^16.4.5",
    "jira-contracts": "file:../jira-contracts",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
