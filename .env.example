# Server
PORT=50052
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
NODE_ENV=development

# PostgreSQL Database (sprints_db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sprints_db
DB_SSLMODE=disable
DB_POOL_MAX=20
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY_MS=3000

# MS1 (jira-issues-go) gRPC Client
MS1_GRPC_URL=localhost:50051

# Kafka Request-Reply Client (to MS3 jira-analytics-dotnet)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=jira-sprints-nestjs
KAFKA_GROUP_ID=jira-sprints-reply-consumer
KAFKA_TOPIC_QUERY=analytics.query
KAFKA_TOPIC_REPLY=analytics.reply
KAFKA_REQUEST_TIMEOUT_MS=5000
